# Скопировать в .env и поправить под себя: cp .env.example .env
# Ни одного секрета в репозитории — .env в .gitignore.

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_ADMIN_URL=admin/
DJANGO_LOG_LEVEL=INFO
DJANGO_TIME_ZONE=Europe/Moscow

# Хост localhost и порт 5433 — для запуска с машины (pytest, manage.py):
# 5432 обычно занят локально установленным постгресом.
# Внутри compose приложение ходит в базу по адресу db:5432, это задано в compose.yaml.
DATABASE_URL=postgres://klik:klik@localhost:5433/klik

# Фронт ходит с другого домена: список через запятую, без звёздочки.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Ограничение частоты для анонимов (эндпоинты публичные).
DJANGO_API_ANON_THROTTLE=60/min

# Для контейнера postgres
POSTGRES_DB=klik
POSTGRES_USER=klik
POSTGRES_PASSWORD=klik
POSTGRES_HOST_PORT=5433

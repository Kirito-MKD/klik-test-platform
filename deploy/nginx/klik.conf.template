# Шаблон конфигурации nginx. Официальный образ подставляет ${KLIK_DOMAIN}
# при старте контейнера (envsubst по объявленным переменным окружения),
# поэтому $host, $remote_addr и прочие переменные nginx остаются нетронутыми.

upstream klik_app {
    server app:8000;
}

server {
    listen 80;
    server_name ${KLIK_DOMAIN};

    # Проверка домена для выпуска и обновления сертификата.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${KLIK_DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;

    # Столько же, сколько DATA_UPLOAD_MAX_MEMORY_SIZE в настройках: файл с вопросами
    # должен доезжать до приложения, а не упираться в nginx.
    client_max_body_size 5m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    location /static/ {
        alias /srv/static/;
        expires 30d;
        access_log off;
    }

    location /media/ {
        alias /srv/media/;
        expires 7d;
    }

    location / {
        proxy_pass http://klik_app;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Без этого заголовка Django считает соединение незашифрованным
        # и уводит в бесконечный редирект на https.
        proxy_set_header X-Forwarded-Proto $scheme;
        # Если id не прислал фронт, ставим свой: по нему сходятся логи nginx и приложения.
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 30s;
    }
}

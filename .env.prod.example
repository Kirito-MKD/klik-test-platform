# Окружение прод- и staging-контура. Скопировать в .env.prod и заполнить.
# Файл с секретами в репозиторий не попадает — .env* в .gitignore.

DJANGO_SETTINGS_MODULE=config.settings.prod
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=klik.example.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://klik.example.ru
# Адрес админки на проде стоит сменить: /admin/ перебирают ботами.
DJANGO_ADMIN_URL=upravlenie/
DJANGO_LOG_LEVEL=INFO
DJANGO_TIME_ZONE=Europe/Moscow

# Домены фронта, через запятую и без звёздочки.
DJANGO_CORS_ALLOWED_ORIGINS=https://klik.example.ru
DJANGO_API_ANON_THROTTLE=60/min
# Сколько прокси стоит перед приложением: по нему троттлинг находит адрес клиента
# в X-Forwarded-For. В этом контуре прокси один — nginx.
DJANGO_NUM_PROXIES=1

# База: DATABASE_URL приложение получает из compose.prod.yaml по этим значениям.
POSTGRES_DB=klik
POSTGRES_USER=klik
POSTGRES_PASSWORD=

# Домен для nginx и каталог с сертификатами (fullchain.pem и privkey.pem внутри).
KLIK_DOMAIN=klik.example.ru
KLIK_CERTS_DIR=/etc/letsencrypt/live/klik.example.ru

# Бэкапы: куда складывать и сколько дней хранить.
KLIK_BACKUP_DIR=/srv/klik/backups
KLIK_BACKUP_KEEP_DAYS=14
